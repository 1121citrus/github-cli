#!/usr/bin/env bash
# shellcheck shell=bash
# shellcheck disable=SC1091,SC2030,SC2031,SC2034

# github-cli: test include/github shell functions.
#
# These tests source include/github and verify argument construction
# without actually running Docker (docker is stubbed).
#
# Copyright (C) 2026 James Hanlon [mailto:jim@hanlonsoftware.com]
# SPDX-License-Identifier: AGPL-3.0-or-later

set -euo pipefail

setup() {
    whereami=$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")
    root="${whereami}/.."
    chmod +x "${whereami}/bin/"*
}

# Helper: source include/github with docker stubbed, then invoke github().
# Captures the docker command line emitted by the stub.
_run_github_fn() {
    (
        # Override PATH so the docker stub is found first.
        export PATH="${whereami}/bin:${PATH}"
        # Defeat TTY detection — tests run non-interactively.
        # shellcheck source=../include/github
        source "${root}/include/github"
        github "$@"
    )
}

_assert_contains() {
    local description=$1 expected=$2 output=$3
    if [[ "${output}" == *"${expected}"* ]]; then
        echo "PASS '${FUNCNAME[1]}': ${description}"
    else
        echo "FAIL '${FUNCNAME[1]}': ${description} — expected '${expected}' in output"
        return 1
    fi
}

_assert_not_contains() {
    local description=$1 unexpected=$2 output=$3
    if [[ "${output}" != *"${unexpected}"* ]]; then
        echo "PASS '${FUNCNAME[1]}': ${description}"
    else
        echo "FAIL '${FUNCNAME[1]}': ${description} — did not expect '${unexpected}' in output"
        return 1
    fi
}

test_basic_invocation_passes_args() {
    local output
    output=$(_run_github_fn repo list) || {
        echo "FAIL '${FUNCNAME[0]}': function exited non-zero"; return 1
    }
    _assert_contains "passes 'repo' arg" "repo" "${output}"
    _assert_contains "passes 'list' arg" "list" "${output}"
}

test_config_dir_is_set() {
    local output
    output=$(_run_github_fn --version) || {
        echo "FAIL '${FUNCNAME[0]}': function exited non-zero"; return 1
    }
    _assert_contains "GH_CONFIG_DIR set" "GH_CONFIG_DIR=/gh-config" "${output}"
}

test_workspace_mounted() {
    local output
    output=$(_run_github_fn --version) || {
        echo "FAIL '${FUNCNAME[0]}': function exited non-zero"; return 1
    }
    _assert_contains "workspace volume" "/workspace" "${output}"
}

test_gh_config_mounted() {
    local output
    output=$(_run_github_fn --version) || {
        echo "FAIL '${FUNCNAME[0]}': function exited non-zero"; return 1
    }
    _assert_contains "config mount" "/gh-config" "${output}"
    _assert_not_contains "not read-only" ":ro" "${output}"
}

test_pat_not_passed_when_unset() {
    local output
    unset GITHUB_PAT 2>/dev/null || true
    output=$(_run_github_fn --version) || {
        echo "FAIL '${FUNCNAME[0]}': function exited non-zero"; return 1
    }
    _assert_not_contains "GH_TOKEN absent" "GH_TOKEN" "${output}"
}

test_pat_passed_when_set() {
    local output
    GITHUB_PAT="ghp_test123" output=$(_run_github_fn --version) || {
        echo "FAIL '${FUNCNAME[0]}': function exited non-zero"; return 1
    }
    _assert_contains "GH_TOKEN present" "GH_TOKEN=ghp_test123" "${output}"
}

test_runs_as_host_user() {
    local output
    output=$(_run_github_fn --version) || {
        echo "FAIL '${FUNCNAME[0]}': function exited non-zero"; return 1
    }
    _assert_contains "user flag" "--user" "${output}"
}

test_no_tty_in_noninteractive() {
    local output
    output=$(_run_github_fn --version) || {
        echo "FAIL '${FUNCNAME[0]}': function exited non-zero"; return 1
    }
    # In a non-interactive test, -t should NOT appear (only -i).
    _assert_not_contains "no -t flag" " -t " "${output}"
}

test_pat_file_reads_secret() {
    local output tmpfile
    tmpfile=$(mktemp)
    echo "ghp_fromfile" > "${tmpfile}"
    unset GITHUB_PAT 2>/dev/null || true
    GITHUB_PAT_FILE="${tmpfile}" output=$(_run_github_fn --version) || {
        rm -f "${tmpfile}"; unset GITHUB_PAT_FILE
        echo "FAIL '${FUNCNAME[0]}': function exited non-zero"; return 1
    }
    rm -f "${tmpfile}"; unset GITHUB_PAT_FILE
    _assert_contains "GH_TOKEN from file" "GH_TOKEN=ghp_fromfile" "${output}"
}

test_username_file_reads_secret() {
    local output tmpfile_pat tmpfile_user
    tmpfile_pat=$(mktemp); tmpfile_user=$(mktemp)
    echo "ghp_fromfile" > "${tmpfile_pat}"
    echo "fileuser" > "${tmpfile_user}"
    unset GITHUB_PAT GITHUB_USERNAME 2>/dev/null || true
    GITHUB_PAT_FILE="${tmpfile_pat}" GITHUB_USERNAME_FILE="${tmpfile_user}" \
        output=$(_run_github_fn --version) || {
        rm -f "${tmpfile_pat}" "${tmpfile_user}"
        unset GITHUB_PAT_FILE GITHUB_USERNAME_FILE
        echo "FAIL '${FUNCNAME[0]}': function exited non-zero"; return 1
    }
    rm -f "${tmpfile_pat}" "${tmpfile_user}"
    unset GITHUB_PAT_FILE GITHUB_USERNAME_FILE
    _assert_contains "GH_TOKEN from file" "GH_TOKEN=ghp_fromfile" "${output}"
}

test_pat_file_missing_returns_error() {
    local output
    unset GITHUB_PAT 2>/dev/null || true
    GITHUB_PAT_FILE="/nonexistent/path" output=$(_run_github_fn --version 2>&1) && {
        unset GITHUB_PAT_FILE
        echo "FAIL '${FUNCNAME[0]}': expected non-zero exit"
        return 1
    }
    unset GITHUB_PAT_FILE
    _assert_contains "error message" "cannot read GITHUB_PAT_FILE" "${output}"
}

test_username_file_missing_returns_error() {
    local output
    unset GITHUB_PAT GITHUB_USERNAME 2>/dev/null || true
    GITHUB_USERNAME_FILE="/nonexistent/path" output=$(_run_github_fn --version 2>&1) && {
        unset GITHUB_USERNAME_FILE
        echo "FAIL '${FUNCNAME[0]}': expected non-zero exit"
        return 1
    }
    unset GITHUB_USERNAME_FILE
    _assert_contains "error message" "cannot read GITHUB_USERNAME_FILE" "${output}"
}

test_plain_var_takes_precedence_over_file() {
    local output tmpfile
    tmpfile=$(mktemp)
    echo "ghp_fromfile" > "${tmpfile}"
    GITHUB_PAT="ghp_direct" GITHUB_PAT_FILE="${tmpfile}" \
        output=$(_run_github_fn --version) || {
        rm -f "${tmpfile}"; unset GITHUB_PAT_FILE
        echo "FAIL '${FUNCNAME[0]}': function exited non-zero"; return 1
    }
    rm -f "${tmpfile}"; unset GITHUB_PAT_FILE
    _assert_contains "direct var wins" "GH_TOKEN=ghp_direct" "${output}"
    _assert_not_contains "file value absent" "ghp_fromfile" "${output}"
}

test_image_tag_is_latest() {
    local output
    output=$(_run_github_fn --version) || {
        echo "FAIL '${FUNCNAME[0]}': function exited non-zero"; return 1
    }
    _assert_contains "image tag" "1121citrus/github-cli:latest" "${output}"
}

test_gh_alias_works() {
    # gh() must be an alias for github() and produce identical output.
    local out_github out_gh
    out_github=$(_run_github_fn --version) || {
        echo "FAIL '${FUNCNAME[0]}': github() exited non-zero"; return 1
    }
    # Call gh() directly by sourcing inside the subshell.
    out_gh=$(
        export PATH="${whereami}/bin:${PATH}"
        # shellcheck source=../include/github
        source "${root}/include/github"
        gh --version
    ) || {
        echo "FAIL '${FUNCNAME[0]}': gh() exited non-zero"; return 1
    }
    if [[ "${out_github}" == "${out_gh}" ]]; then
        echo "PASS '${FUNCNAME[0]}': gh() produces identical output to github()"
    else
        echo "FAIL '${FUNCNAME[0]}': gh() and github() outputs differ"
        return 1
    fi
}

test_cap_drop_all() {
    local output
    output=$(_run_github_fn --version) || {
        echo "FAIL '${FUNCNAME[0]}': function exited non-zero"; return 1
    }
    _assert_contains "--cap-drop ALL present" "--cap-drop ALL" "${output}"
}

test_no_new_privileges() {
    local output
    output=$(_run_github_fn --version) || {
        echo "FAIL '${FUNCNAME[0]}': function exited non-zero"; return 1
    }
    _assert_contains "--security-opt no-new-privileges" "no-new-privileges:true" "${output}"
}

run_tests() {
    local passed=0
    local -a tests=(
        test_basic_invocation_passes_args
        test_config_dir_is_set
        test_workspace_mounted
        test_gh_config_mounted
        test_runs_as_host_user
        test_pat_not_passed_when_unset
        test_pat_passed_when_set
        test_pat_file_reads_secret
        test_username_file_reads_secret
        test_pat_file_missing_returns_error
        test_username_file_missing_returns_error
        test_plain_var_takes_precedence_over_file
        test_no_tty_in_noninteractive
        test_image_tag_is_latest
        test_gh_alias_works
        test_cap_drop_all
        test_no_new_privileges
    )

    setup || { echo "ERROR: Setup failed"; return 1; }

    echo "Running tests for include/github shell functions..."
    echo "========================================================"

    for test in "${tests[@]}"; do
        { "${test}" && ((passed++)) } || :
    done

    local failed=$(( ${#tests[@]} - passed ))
    echo "========================================================"
    echo "Results: ${passed} passed, ${failed} failed"
    return "${failed}"
}

[[ "${BASH_SOURCE[0]}" == "$0" ]] && run_tests
