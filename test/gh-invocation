set -euo pipefail

setup() {
    IMAGE=${IMAGE:-1121citrus/github-cli:latest}

    run_gh() {
        docker run --rm "${IMAGE}" "$@" 2>&1
    }
    export -f run_gh
}

test_gh_version_output() {
    local output
    output=$(run_gh --version) || {
        echo "FAIL '${FUNCNAME[0]}': gh --version exited non-zero"; return 1
    }
    if [[ "${output}" == *"gh version"* ]]; then
        echo "PASS '${FUNCNAME[0]}': gh --version produces expected output"
    else
        echo "FAIL '${FUNCNAME[0]}': expected 'gh version' in output, got '${output}'"
        return 1
    fi
}

test_gh_help_output() {
    local output
    output=$(run_gh help) || {
        echo "FAIL '${FUNCNAME[0]}': gh help exited non-zero"; return 1
    }
    if [[ "${output}" == *"USAGE"* || "${output}" == *"usage"* || "${output}" == *"Available commands"* || "${output}" == *"CORE COMMANDS"* ]]; then
        echo "PASS '${FUNCNAME[0]}': gh help produces usage information"
    else
        echo "FAIL '${FUNCNAME[0]}': expected usage information in help output"
        return 1
    fi
}

test_gh_unknown_command_fails() {
    run_gh this-command-does-not-exist > /dev/null 2>&1 && result=0 || result=$?
    if [[ ${result} -ne 0 ]]; then
        echo "PASS '${FUNCNAME[0]}': gh exits non-zero for unknown command"
    else
        echo "FAIL '${FUNCNAME[0]}': expected non-zero exit for unknown command"
        return 1
    fi
}

test_entrypoint_is_gh() {
    local output
    output=$(docker inspect --format '{{json .Config.Entrypoint}}' "${IMAGE}" 2>&1) || {
        echo "FAIL '${FUNCNAME[0]}': docker inspect failed"; return 1
    }
    if [[ "${output}" == '["gh"]' ]]; then
        echo "PASS '${FUNCNAME[0]}': ENTRYPOINT is [\"gh\"]"
    else
        echo "FAIL '${FUNCNAME[0]}': expected ENTRYPOINT [\"gh\"], got '${output}'"
        return 1
    fi
}

run_tests() {
    local passed=0
    local tests=(
        test_gh_version_output
        test_gh_help_output
        test_gh_unknown_command_fails
        test_entrypoint_is_gh
    )

    setup || { echo "ERROR: Setup failed"; return 1; }

    echo "Running tests for gh invocation..."
    echo "========================================================"

    for test in "${tests[@]}"; do
        "${test}" && ((passed++)) || :
    done

    local failed=$(( ${#tests[@]} - passed ))
    echo "========================================================"
    echo "Results: ${passed} passed, ${failed} failed"
    return "${failed}"
}

[[ "${BASH_SOURCE[0]}" == "$0" ]] && run_tests
