set -euo pipefail

setup() {
    IMAGE=${IMAGE:-1121citrus/github-cli:latest}

    run_image() {
        docker run --rm --entrypoint /bin/sh "${IMAGE}" -c "$1" 2>&1
    }
    export -f run_image
}

test_runs_as_non_root() {
    local output
    output=$(run_image "id -u") || {
        echo "FAIL '${FUNCNAME[0]}': command exited non-zero"; return 1
    }
    if [[ "${output}" == "10001" ]]; then
        echo "PASS '${FUNCNAME[0]}': container runs as UID 10001"
    else
        echo "FAIL '${FUNCNAME[0]}': expected UID 10001, got '${output}'"
        return 1
    fi
}

test_user_is_github_cli() {
    local output
    output=$(run_image "whoami") || {
        echo "FAIL '${FUNCNAME[0]}': command exited non-zero"; return 1
    }
    if [[ "${output}" == "github-cli" ]]; then
        echo "PASS '${FUNCNAME[0]}': container user is 'github-cli'"
    else
        echo "FAIL '${FUNCNAME[0]}': expected user 'github-cli', got '${output}'"
        return 1
    fi
}

test_workdir_is_workspace() {
    local output
    output=$(run_image "pwd") || {
        echo "FAIL '${FUNCNAME[0]}': command exited non-zero"; return 1
    }
    if [[ "${output}" == "/workspace" ]]; then
        echo "PASS '${FUNCNAME[0]}': WORKDIR is /workspace"
    else
        echo "FAIL '${FUNCNAME[0]}': expected /workspace, got '${output}'"
        return 1
    fi
}

test_gh_binary_exists() {
    run_image "command -v gh" > /dev/null || {
        echo "FAIL '${FUNCNAME[0]}': gh binary not found"; return 1
    }
    echo "PASS '${FUNCNAME[0]}': gh binary is installed"
}

test_git_binary_exists() {
    run_image "command -v git" > /dev/null || {
        echo "FAIL '${FUNCNAME[0]}': git binary not found"; return 1
    }
    echo "PASS '${FUNCNAME[0]}': git binary is installed"
}

test_bash_binary_exists() {
    run_image "command -v bash" > /dev/null || {
        echo "FAIL '${FUNCNAME[0]}': bash binary not found"; return 1
    }
    echo "PASS '${FUNCNAME[0]}': bash binary is installed"
}

test_no_login_shell() {
    local output
    output=$(run_image "grep github-cli /etc/passwd | cut -d: -f7") || {
        echo "FAIL '${FUNCNAME[0]}': command exited non-zero"; return 1
    }
    if [[ "${output}" == "/sbin/nologin" ]]; then
        echo "PASS '${FUNCNAME[0]}': github-cli user shell is /sbin/nologin"
    else
        echo "FAIL '${FUNCNAME[0]}': expected /sbin/nologin, got '${output}'"
        return 1
    fi
}

test_no_home_directory() {
    run_image "test ! -d /home/github-cli" && result=0 || result=$?
    if [[ ${result} -eq 0 ]]; then
        echo "PASS '${FUNCNAME[0]}': no home directory for github-cli user"
    else
        echo "FAIL '${FUNCNAME[0]}': /home/github-cli should not exist"
        return 1
    fi
}

run_tests() {
    local passed=0
    local tests=(
        test_runs_as_non_root
        test_user_is_github_cli
        test_workdir_is_workspace
        test_gh_binary_exists
        test_git_binary_exists
        test_bash_binary_exists
        test_no_login_shell
        test_no_home_directory
    )

    setup || { echo "ERROR: Setup failed"; return 1; }

    echo "Running tests for image structure..."
    echo "========================================================"

    for test in "${tests[@]}"; do
        "${test}" && ((passed++)) || :
    done

    local failed=$(( ${#tests[@]} - passed ))
    echo "========================================================"
    echo "Results: ${passed} passed, ${failed} failed"
    return "${failed}"
}

[[ "${BASH_SOURCE[0]}" == "$0" ]] && run_tests
