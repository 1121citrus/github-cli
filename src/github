#!/usr/bin/env bash
# shellcheck shell=bash
#
# github-cli shell functions — source this file in .bashrc / .bash_profile.
#
# Authentication (in priority order):
#   1. GITHUB_PAT env var  → passed as GH_TOKEN to the container
#   2. ~/.config/gh        → mounted into the container
#
# Docker-secrets support: GITHUB_PAT_FILE and GITHUB_USERNAME_FILE may
# point to files whose first line is read as the value.  The plain env
# vars take precedence over the _FILE variants.
#
# If GITHUB_USERNAME is set alongside GITHUB_PAT, it is exported as
# GITHUB_LOGIN for use by calling scripts.
#
# The container runs as the host user's UID/GID so that git operations
# (e.g. gh repo create --source=.) can write to the mounted workspace.
#
# Additional hardening applied to every container invocation:
#   --cap-drop ALL              drop all Linux capabilities (gh only needs
#                               network + file I/O; no capabilities required)
#   --security-opt no-new-privileges:true
#                               prevent setuid/setgid privilege escalation

function gh() {
    github "$@"
}

function github() {
    function __github_cli__include__github__read_secret_file() {
        # Read the first line of a file into a variable.  Returns 1 if the file
        # is missing, unreadable, or empty.
        local file=$1
        [[ -r "${file}" ]] || return 1
        local value
        IFS= read -r value < "${file}" || true
        [[ -n "${value}" ]] || return 1
        printf '%s' "${value}"
    }

    # Resolve _FILE variants when the plain env var is not set.
    local pat="${GITHUB_PAT:-}"
    if [[ -z "${pat}" && -n "${GITHUB_PAT_FILE:-}" ]]; then
        pat=$(__github_cli__include__github__read_secret_file "${GITHUB_PAT_FILE}") || {
            echo "github-cli: cannot read GITHUB_PAT_FILE (${GITHUB_PAT_FILE})" >&2
            return 1
        }
    fi

    local username="${GITHUB_USERNAME:-}"
    if [[ -z "${username}" && -n "${GITHUB_USERNAME_FILE:-}" ]]; then
        username=$(__github_cli__include__github__read_secret_file "${GITHUB_USERNAME_FILE}") || {
            echo "github-cli: cannot read GITHUB_USERNAME_FILE (${GITHUB_USERNAME_FILE})" >&2
            return 1
        }
    fi

    local -a auth_env=()
    if [[ -n "${pat}" ]]; then
        auth_env=(-e "GH_TOKEN=${pat}")
        if [[ -n "${username}" ]]; then
            export GITHUB_LOGIN="${username}"
        fi
    fi

    # Allocate a TTY only when stdin and stdout are terminals.
    local -a tty_flags=(-i)
    if [[ -t 0 ]] && [[ -t 1 ]]; then
        tty_flags+=(-t)
    fi

    # Create host-side gh config/cache directories so bind mounts succeed.
    local host_gh_config_dir="${HOME}/.config/gh"
    local host_gh_cache_root="${XDG_CACHE_HOME:-${HOME}/.cache}"
    local host_gh_cache_dir="${host_gh_cache_root}/gh"
    mkdir -p "${host_gh_config_dir}" "${host_gh_cache_dir}"

    docker run --rm "${tty_flags[@]}" \
        --user "$(id -u):$(id -g)" \
        --cap-drop ALL \
        --security-opt no-new-privileges:true \
        "${auth_env[@]}" \
        -e GH_CONFIG_DIR=/gh-config \
        -e XDG_CACHE_HOME=/gh-cache \
        -v "${host_gh_config_dir}:/gh-config" \
        -v "${host_gh_cache_dir}:/gh-cache" \
        -v "${PWD}:/workspace" \
        1121citrus/github-cli:latest "$@"
}
